# Database — copier les URLs EXACTES depuis Supabase → Settings → Database → Connection string
# Prisma lit .env.local via npm run db:migrate:deploy (pas npx prisma directement)

# Runtime : Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations : Session mode pooler (port 5432) OU connexion directe db.[ref].supabase.co:5432
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# App URL (production)
NEXT_PUBLIC_APP_URL="https://solviaa.vercel.app"

# Supabase Auth — copier depuis Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Encryption (32-byte hex for AES-256)
ENCRYPTION_KEY="your-64-char-hex-key"

# Vercel Cron auth
CRON_SECRET="your-cron-secret"

# Email notifications (Resend)
EMAIL_PROVIDER_API_KEY="re_..."
EMAIL_FROM="alerts@yourdomain.com"

# WhatsApp notifications (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
